{
  "name": "WiseHub materials CUDA",
  // Builds on the cuda base tier; every Feature is a published reference (see recipe/README.md).
  "build": {
    "dockerfile": "../../../base/cuda/.devcontainer/Dockerfile",
    "context": "../../../base/cuda/.devcontainer"
  },
  // MPI inside one container: shared-memory transport needs a large /dev/shm, single-copy (CMA) needs
  // ptrace between sibling ranks, RDMA needs unlimited locked memory. Add --device=/dev/infiniband and
  // --network=host on InfiniBand/RoCE nodes.
  "runArgs": ["--shm-size=16g", "--cap-add=SYS_PTRACE", "--ulimit", "memlock=-1:-1"],
  "features": {
    // MPI and UCX come from the CUDA base image's HPC-X.
    "harbor.will/wise/wise-compute-features/toolchains/python:1": {},
    "harbor.will/wise/wise-compute-features/toolchains/conda:1": {},
    "harbor.will/wise/wise-compute-features/toolchains/uv:1": {},
    "harbor.will/wise/wise-compute-features/toolchains/rust:1": {},
    "harbor.will/wise/wise-compute-features/toolchains/nodejs:1": {},
    // Parallel I/O and the distributed eigensolver for large systems.
    "harbor.will/wise/wise-compute-features/infra/hdf5:1": {},
    "harbor.will/wise/wise-compute-features/infra/netcdf:1": {},
    "harbor.will/wise/wise-compute-features/infra/elpa:1": { "cudaArch": "80" },
    "harbor.will/wise/wise-compute-features/applications/materials-python:1": {},
    "harbor.will/wise/wise-compute-features/applications/mpi4py:1": {},
    // GPU builds against the HPC SDK of the CUDA base image: tuned for A100 (sm_80); QE also carries
    // H100 code (sm_90), Kokkos and CP2K embed sm_80 PTX that newer GPUs JIT-compile.
    "harbor.will/wise/wise-compute-features/applications/lammps:2": { "variant": "cuda", "gpuArch": "AMPERE80", "extraPackages": "H5MD,NETCDF" },
    "harbor.will/wise/wise-compute-features/applications/quantum-espresso:2": { "cudaCC": "80,90", "elpa": true, "hdf5": true },
    "harbor.will/wise/wise-compute-features/applications/cp2k:2": { "gpuVersion": "A100", "elpa": true, "hdf5": true, "largeSystems": true },
    "harbor.will/wise/wise-compute-features/applications/wannier90:1": {},
    "harbor.will/wise/wise-compute-features/applications/packmol:1": {}
  }
}
