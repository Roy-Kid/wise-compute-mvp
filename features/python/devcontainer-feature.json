{
  "id": "python",
  "version": "1.0.0",
  "name": "Python venv (system CPython)",
  "description": "Installs system CPython + build toolchain and a shared venv at /opt/wise/venv.",
  "options": {},
  "containerEnv": {
    "PATH": "/opt/wise/venv/bin:${PATH}"
  },
  "customizations": {
    "wisehub": {
      "provides": {
        "python-abi": "cp312"
      },
      "smoke": "python -c 'import sys; assert sys.prefix==\"/opt/wise/venv\"; print(sys.version.split()[0])'"
    }
  }
}
